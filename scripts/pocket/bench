#!/usr/bin/env bash
# Runs the AirPods bench test with its Python environment:  ./scripts/pocket/bench all
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$HERE/.venv/bin/python"
if [ ! -x "$PY" ]; then
    echo "Run the setup first:  bash scripts/pocket/setup_bench.sh"
    exit 1
fi
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec "$PY" "$HERE/bench.py" "$@"
